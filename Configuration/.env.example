# Copy this file to .env in your n8n instance (or set these as environment
# variables however your host does it - Docker Compose, PikaPods, systemd, etc).
# Every workflow in Workflows/ reads its config from these variables.
# Nothing here is a placeholder value you can leave as-is - fill in all of it.

# ---- Business identity ----
BUSINESS_NAME="Your Roofing & Solar Co"
SERVICE_POSTCODES="2000,2010,2020,2030"          # comma-separated, no spaces
STC_MESSAGE="The federal solar rebate steps down every 1 Jan as the scheme winds down (ends 2030) - locking in this year keeps the current discount."
GOOGLE_REVIEW_LINK="https://g.page/r/your-google-business-id/review"
RESCHEDULE_LINK="https://meetings.hubspot.com/your-team/reschedule"

# ---- HubSpot (Settings > Integrations > Private Apps) ----
HUBSPOT_TOKEN="pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
HUBSPOT_PORTAL_ID="12345678"
HUBSPOT_PIPELINE_ID="default"                     # find in pipeline settings URL
HUBSPOT_STAGE_QUALIFIED="qualified-ready-to-book"  # internal stage IDs, not labels
HUBSPOT_STAGE_NURTURE="nurture-cold"
HUBSPOT_STAGE_BOOKED="appointment-booked"
HUBSPOT_STAGE_WON="closedwon"
HUBSPOT_STAGE_LOST="lost-no-show"

# ---- AI model(s) ----
# AI_PROVIDER_DEFAULT is used for every channel except the website (Telegram, FB/IG, WhatsApp
# always use this). The website can request a different provider per-visitor via its
# "Integration settings" panel - that preference travels with the lead as ai_provider, but the
# actual API key below is always read from here, never from anything the browser sends.
AI_PROVIDER_DEFAULT="anthropic"                     # anthropic | gemini | grok

ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---- Google Gemini (only needed if you'll use "gemini" as a provider) ----
GOOGLE_AI_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"   # console: aistudio.google.com/apikey
GEMINI_MODEL="gemini-2.5-flash"                     # change freely; this is just the default

# ---- xAI Grok (only needed if you'll use "grok" as a provider) ----
XAI_API_KEY="xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"     # console: console.x.ai
GROK_MODEL="grok-4-0709"                            # change freely; this is just the default

# ---- Telegram ----
TELEGRAM_BOT_TOKEN="123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TELEGRAM_OPS_CHAT_ID="-1001234567890"              # the internal group/chat that gets escalation alerts

# ---- Meta (Facebook Page + Instagram Business, same app) ----
META_VERIFY_TOKEN="choose-any-random-string-yourself"
META_PAGE_ACCESS_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---- WhatsApp (optional - only needed if you enable it, see docs/08-whatsapp-optional.md) ----
WHATSAPP_VERIFY_TOKEN="choose-any-random-string-yourself"
WHATSAPP_ACCESS_TOKEN="EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WHATSAPP_PHONE_NUMBER_ID="123456789012345"

# ---- Twilio (SMS fallback, for leads with no chat channel) ----
TWILIO_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"   # used to create the n8n credential, not read directly by workflows
TWILIO_FROM_NUMBER="+61491570156"
