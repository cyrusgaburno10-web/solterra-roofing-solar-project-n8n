      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 100],
      "parameters": {
        "method": "GET",
        "url": "=https://api.hubapi.com/crm/v4/objects/deals/{{ $json.id }}/associations/contacts",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Authorization", "value": "=Bearer {{ $env.HUBSPOT_TOKEN }}" } ] },
        "options": {}
      }
    },
    {
      "id": "code-extract-contact-24h",
      "name": "Extract Contact ID (24h)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 100],
      "parameters": {
        "jsCode": "const dealId = $('Split 24h Deals').item.json.id;\nconst contactId = $json.results && $json.results[0] && $json.results[0].toObjectId;\nreturn { json: { dealId, contactId } };"
      }
    },
    {
      "id": "http-contact-info-24h",
      "name": "Get Contact Channel Info (24h)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 100],
      "parameters": {
        "method": "GET",
        "url": "=https://api.hubapi.com/crm/v3/objects/contacts/{{ $json.contactId }}?properties=firstname,preferred_channel,external_chat_id,phone",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Authorization", "value": "=Bearer {{ $env.HUBSPOT_TOKEN }}" } ] },
        "options": {}
      }
    },
    {
      "id": "code-build-send-24h",
      "name": "Build Send - 24h Reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, 100],
      "parameters": {
        "jsCode": "const p = $json.properties;\nconst prev = $('Extract Contact ID (24h)').item.json;\nconst text = `Reminder: your roofing/solar appointment is tomorrow. Our rep will call ahead. Reply here if you need to reschedule.`;\nconst channel = (p.external_chat_id || '').split(':')[0] || 'none';\nconst id = (p.external_chat_id || '').split(':')[1] || '';\nreturn { json: { dealId: prev.dealId, channel, id, phone: p.phone, text, markField: 'reminder_24h_sent' } };"
      }
    },
